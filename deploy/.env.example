# Threshold API settings. Copy to .env in the repo root and fill in the real
# values. Never commit the real .env (git ignores it).

REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional free LLM (OpenAI-compatible; default Groq). CV upload/feedback
# returns HTTP 503 without this set.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Comma separated. Set to the website's address once deployed. Browsers are
# refused for any site not listed here.
CORS_ALLOW_ORIGINS=https://your-app.vercel.app

# Optional: a shared key for /analyze, for scripts and server-to-server calls
# only. The website does not send it, because a browser app cannot keep a key
# secret. Leave it unset for a public site and rely on the rate limit.
# ANALYZE_API_KEY=

# Limits per client address, per minute, counted in each server process
# (defaults shown, 0 turns a limit off). The last one caps how many searches
# one process runs at once. Extra searches get a clear "busy" message.
# ANALYZE_RATE_LIMIT_PER_MIN=6
# SPONSOR_CHECK_RATE_LIMIT_PER_MIN=30
# ACCOUNT_RATE_LIMIT_PER_MIN=120
# ANALYZE_MAX_CONCURRENT=2

# Sign-in checks (saved searches and profile). CLERK_ISSUER is REQUIRED for these
# routes: without it they answer 503. It is your Clerk instance address (the
# Frontend API URL in the Clerk dashboard). The API only trusts tokens signed by
# the keys at this address, never an address that a token names itself.
# CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
# Only if the signing keys are somewhere else. Default: <issuer>/.well-known/jwks.json
# CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Recommended: the website addresses allowed to use a token, comma separated.
# CLERK_AUTHORIZED_PARTIES=https://your-frontend.vercel.app

# Production is the default. Set APP_ENV=local only on a developer machine: it turns
# on the API docs pages and allows CLERK_DEV_BYPASS=1. The API refuses to start with
# CLERK_DEV_BYPASS=1 in any other environment.
# APP_ENV=production
# The interactive API docs (/docs) are off in production unless this is 1.
# ENABLE_API_DOCS=

# Speed settings (defaults shown). Lower them if a small server struggles.
# ANALYZE_MAX_PER_SOURCE=100
# ANALYZE_MAX_REED_ENRICH=30
# ANALYZE_MAX_ATS_BOARDS=12

# DEBUG, INFO (default), WARNING or ERROR.
# LOG_LEVEL=INFO
