# Threshold API — production .env template for the Oracle instance.
# Copy to .env in the repo root and fill in real values. Never commit the
# real .env — it's already gitignored.

REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional free LLM (OpenAI-compatible; default Groq). CV upload/feedback
# returns HTTP 503 without this set.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Comma-separated. Set to your real Vercel URL(s) once deployed — the API
# rejects cross-origin requests from anywhere not listed here.
CORS_ALLOW_ORIGINS=https://your-app.vercel.app

# Optional: gate /analyze behind a shared header key (recommended once the
# API is publicly reachable, to keep it from being hit directly by anyone
# who finds the URL).
# ANALYZE_API_KEY=
# ANALYZE_RATE_LIMIT_PER_MIN=6

# Only needed once Clerk is configured on the frontend, for verifying signed-in
# requests (saved searches / profile). If unset, the API derives JWKS from the
# token issuer automatically — usually fine to leave blank.
# CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev

# Speed knobs (optional, defaults shown). Lower these if the instance's CPU
# struggles with the sponsor-matching workload under a modest OCI shape.
# ANALYZE_MAX_PER_SOURCE=100
# ANALYZE_MAX_REED_ENRICH=30
# ANALYZE_MAX_ATS_BOARDS=12
